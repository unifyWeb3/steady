# Somnia × DreamDEX — Steady
# Copy to .env locally: cp .env.example .env
# Never commit .env. Never put secrets in NEXT_PUBLIC_*.

# ── Browser-safe (may be NEXT_PUBLIC_*) ──
# Shannon testnet only. Mainnet 5031 is BLOCKED until explicitly authorized.
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
NEXT_PUBLIC_RPC_HTTP_URL=https://api.infra.testnet.somnia.network

# ── Local / test-wallet (never committed, never browser) ──
# Funded Shannon burner for scripts/validate:write only.
# Get STT from Telegram faucet topic + tUSDC via trader.faucet() (10k cap).
# Format: 0x + 64 hex chars. Leave empty if not funded.
TEST_WALLET_PRIVATE_KEY=

# ── Server-only (never browser) ──
# Only if indexer requires Hasura admin/role (dev.smk endpoint does not).
# JSON string e.g. '{"x-hasura-admin-secret":"..."}' — never NEXT_PUBLIC_*.
INDEXER_HEADERS=

# ── Optional ──
# EMA price-feed (only if using scoring feed). MVP does not require.
# PRICE_FEED_URL=https://price-feed.dev.oracle.somnia.host/v1/graphql
# PRICE_FEED_QUOTE=USDC
